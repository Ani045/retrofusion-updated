RewriteEngine On
RewriteBase /all-blogs/

# Disable MultiViews to prevent Apache from guessing extensions
Options -MultiViews

# Disable auto DirectorySlash to avoid redirect conflicts
DirectorySlash Off

# 1. Externally redirect URLs with embedded .php/ (e.g. /foo.php/ -> /foo/)
#    This handles cases like /all-blogs/foo/.php/ or /all-blogs/foo.php/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/all-blogs/([^/.]+)(\.php)/?[\s?] [NC]
RewriteRule ^([^/.]+)\.php/?$ /all-blogs/%1/ [R=301,L]

# 2. Externally redirect URLs with .php in the path (e.g. /foo.php)
#    /all-blogs/foo.php -> /all-blogs/foo/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/all-blogs/([^/.]+)\.php[\s?] [NC]
RewriteRule ^([^/.]+)\.php$ /all-blogs/%1/ [R=301,L]

# 3. Externally redirect URLs without trailing slash to pretty URLs (with trailing slash)
#    /all-blogs/foo -> /all-blogs/foo/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/all-blogs/([^/.]+)$ [NC]
RewriteRule ^([^/.]+)$ /all-blogs/%1/ [R=301,L]

# 4. Internally rewrite pretty URLs to the actual PHP files
#    /all-blogs/foo/ -> /all-blogs/foo.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/all-blogs/$1.php -f
RewriteRule ^([^/.]+)/$ $1.php [L]
