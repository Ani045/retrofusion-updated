RewriteEngine On

# Disable Apache's automatic DirectorySlash to prevent redirect loops
DirectorySlash Off
# ============================================================
# 1. Internal rewrite: /all-blogs/{slug}/ (with trailing slash)
#    should internally serve /all-blogs/{slug}.php
# ============================================================
RewriteCond %{REQUEST_URI} ^/all-blogs/([^/]+)/$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/all-blogs/%1.php -f
RewriteRule ^all-blogs/([^/]+)/$ all-blogs/$1.php [L]

# ============================================================
# 2. Strip .php extension: /foo.php -> /foo (301 redirect)
#    EXCEPT for mailer scripts (preserve POST data)
# ============================================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/mail1\.php [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler\.php [NC]
RewriteRule ^(.*)\.php$ $1 [R=301,L]

# ============================================================
# 3. Force trailing slash on /all-blogs/{slug} (no extension)
#    /all-blogs/foo -> /all-blogs/foo/
# ============================================================
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} ^/all-blogs/[^.]+$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(all-blogs/[^.]+)$ $1/ [R=301,L]

# ============================================================
# 4. Internal rewrite: serve .php file for extensionless URLs
#    /foo -> /foo.php (single-segment only, if .php exists)
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/ [NC]
RewriteCond %{REQUEST_URI} !^/mail1$ [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^./]+)$ $1.php [L]

# ============================================================
# 5. Redirect /index and /index.php to root domain
# ============================================================
Redirect 301 /index https://retrofusion.in/
Redirect 301 /index.php https://retrofusion.in/


