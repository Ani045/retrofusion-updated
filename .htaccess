RewriteEngine On

# Redirect /index and /index.php to root domain
Redirect 301 /index https://retrofusion.in/
Redirect 301 /index.php https://retrofusion.in/


Redirect 301 /retro-villa.php /retro-villas
Redirect 301 /neo-villa.php /neo-retro
Redirect 301 /viswa-villa.php /retro-viswa-lonavala
Redirect 301 /retro-villa /retro-villas
Redirect 301 /neo-villa /neo-retro
Redirect 301 /viswa-villa /retro-viswa-lonavala

# Blogs-copy: remove .php extension
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/blogs-copy/([^.]+)\.php [NC]
RewriteRule ^blogs-copy/([^.]+)$ /blogs-copy/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/blogs-copy/([a-z0-9\-]+)$
RewriteRule ^blogs-copy/([a-z0-9\-]+)$ /blogs-copy/$1.php [L]

# Remove .php extension from all URLs EXCEPT for mailer scripts to preserve POST data
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteCond %{REQUEST_URI} !^/mail1\.php [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Serve .php file internally when extensionless URL is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]



Redirect 301 /blogs https://retrofusion.in/blogs-copy/
