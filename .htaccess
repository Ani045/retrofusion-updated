RewriteEngine On

# Disable MultiViews to prevent Apache from guessing extensions
Options -MultiViews

# Disable auto DirectorySlash on /blog/ to avoid redirect conflicts
# (Apache won't try to add/remove slashes on its own)
DirectorySlash Off

# Prevent browser/proxy from caching 301 redirects so URL changes take effect immediately
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=REDIRECT_STATUS
</IfModule>

# ============================================================
# 3. Strip .php extension
#    /foo.php -> /foo (301)
#    EXCEPT for mailer scripts and blog folder
# ============================================================

# 3a. Strip /.php/ patterns (e.g. /blog/foo/.php/ -> /blog/foo/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.+)/\.php/?[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/mail1 [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler [NC]
RewriteRule ^(.+)/\.php/?$ $1/ [R=301,L]

# 3b. Strip embedded .php/ in a segment (e.g. /blog/foo.php/ -> /blog/foo/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php/?[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/mail1 [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler [NC]
RewriteRule ^([^.]+)\.php/?$ /$1/ [R=301,L]

# 3c. Standard .php extension strip
#    /foo.php -> /foo (301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/blog/ [NC]
RewriteCond %{REQUEST_URI} !^/mail1\.php [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler\.php [NC]
RewriteRule ^(.*)\.php$ $1 [R=301,L]

# ============================================================
# 4. Extensionless URLs (single segment)
#    /foo -> /foo.php (internal rewrite)
#    EXCEPT for blog folder
# ============================================================
RewriteCond %{REQUEST_URI} !^/blog/ [NC]
RewriteCond %{REQUEST_URI} !^/mail1 [NC]
RewriteCond %{REQUEST_URI} !^/whatsapp_handler [NC]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L]

# ============================================================
# 5. Redirect /index and /index.php to root
# ============================================================
Redirect 301 /index https://retrofusion.in/
Redirect 301 /index.php https://retrofusion.in/


Redirect 301 /retro-villa.php /retro-villas
Redirect 301 /neo-villa.php /neo-retro
Redirect 301 /viswa-villa.php /retro-viswa-lonavala
Redirect 301 /retro-villa /retro-villas
Redirect 301 /neo-villa /neo-retro
Redirect 301 /viswa-villa /retro-viswa-lonavala

