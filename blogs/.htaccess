RewriteEngine On
RewriteBase /blogs/

# Disable MultiViews to prevent Apache from guessing extensions
Options -MultiViews

# Disable auto DirectorySlash to avoid redirect conflicts
DirectorySlash Off

# 1. Externally redirect URLs with embedded .php/ (e.g. /foo.php/ -> /foo/)
#    This handles cases like /blogs/foo/.php/ or /blogs/foo.php/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/blogs/([^/.]+)(\.php)/?[\s?] [NC]
RewriteRule ^([^/.]+)\.php/?$ /blogs/%1/ [R=301,L]

# 2. Externally redirect URLs with .php in the path (e.g. /foo.php)
#    /blogs/foo.php -> /blogs/foo/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/blogs/([^/.]+)\.php[\s?] [NC]
RewriteRule ^([^/.]+)\.php$ /blogs/%1/ [R=301,L]

# 3. Externally redirect URLs without trailing slash to pretty URLs (with trailing slash)
#    /blogs/foo -> /blogs/foo/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/blogs/([^/.]+)$ [NC]
RewriteRule ^([^/.]+)$ /blogs/%1/ [R=301,L]

# 4. Internally rewrite pretty URLs to the actual PHP files
#    /blogs/foo/ -> /blogs/foo.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/blogs/$1.php -f
RewriteRule ^([^/.]+)/$ $1.php [L]

# 5. Map relative asset paths (images/css/js) to the correct location
# If the file exists inside /blogs/ folder, use that first (only rewrite if file does not exist at requested path)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/blogs/$1/$2 -f
RewriteRule ^.*/?(images|css|js)/(.*)$ $1/$2 [L]

# Fallback: if the file exists at the root level, use that
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/$2 -f
RewriteRule ^.*/?(images|css|js)/(.*)$ /$1/$2 [L]